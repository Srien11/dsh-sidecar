{
  "name": "dsh-sidecar",
  "version": "0.1.0-beta.0",
  "private": false,
  "description": "Persistent side conversations for DeepSeek Harness without leaving the main thread.",
  "homepage": "https://github.com/Srien11/dsh-sidecar#readme",
  "bugs": {
    "url": "https://github.com/Srien11/dsh-sidecar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Srien11/dsh-sidecar.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "conversation",
    "sidecar",
    "branching"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm clean && tsdown && tsc -p tsconfig.build.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.3.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "jsdom": "26.1.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "shiki": "^4.3.1",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
